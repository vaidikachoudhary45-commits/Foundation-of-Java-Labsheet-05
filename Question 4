
class Patient {
    int patientId;
    String patientName;
    int age;

    Patient(int patientId, String patientName, int age) {
        this.patientId = patientId;
        this.patientName = patientName;
        this.age = age;
    }

    void displayPatient() {
        System.out.println(patientId + " " + patientName + " " + age);
    }
}

class PatientManager {
    void displayAllPatients(Patient[] patients) {
        for (int i = 0; i < patients.length; i++) {
            patients[i].displayPatient();
        }
    }
}

public class PatientMain {
    public static void main(String[] args) {
        Patient[] patients = {
            new Patient(1, "Aman", 25),
            new Patient(2, "Riya", 30),
            new Patient(3, "Rahul", 22),
            new Patient(4, "Neha", 28),
            new Patient(5, "Karan", 35)
        };

        PatientManager pm = new PatientManager();
        pm.displayAllPatients(patients);
    }
}
