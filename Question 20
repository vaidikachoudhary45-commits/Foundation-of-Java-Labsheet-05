
class Employee {
    private int employeeId;
    private String employeeName;
    private double salary;
    static int employeeCount = 0;

    // Protected member available to child classes.
    protected String department = "Pharmacy";

    Employee(int employeeId, String employeeName, double salary) {
        this.employeeId = employeeId;
        this.employeeName = employeeName;
        setSalary(salary);
        employeeCount++;
    }

    public int getEmployeeId() {
        return employeeId;
    }

    public String getEmployeeName() {
        return employeeName;
    }

    public double getSalary() {
        return salary;
    }

    public void setEmployeeId(int employeeId) {
        this.employeeId = employeeId;
    }

    public void setEmployeeName(String employeeName) {
        this.employeeName = employeeName;
    }

    public void setSalary(double salary) {
        if (salary >= 0) {
            this.salary = salary;
        } else {
            System.out.println("Invalid salary");
        }
    }

    // Default-access method.
    void displayEmployee() {
        System.out.println("ID: " + employeeId);
        System.out.println("Name: " + employeeName);
        System.out.println("Salary: " + salary);
        System.out.println("Department: " + department);
    }
}

class Pharmacist extends Employee {
    private String licenseNo;

    Pharmacist(int id, String name, double salary, String licenseNo) {
        super(id, name, salary);
        this.licenseNo = licenseNo;
    }

    void displayRole() {
        displayEmployee();
        System.out.println("Role: Pharmacist");
        System.out.println("License: " + licenseNo);
    }
}

class StoreManager extends Employee {
    private int storeSection;

    StoreManager(int id, String name, double salary, int storeSection) {
        super(id, name, salary);
        this.storeSection = storeSection;
    }

    void displayRole() {
        displayEmployee();
        System.out.println("Role: Store Manager");
        System.out.println("Section: " + storeSection);
    }
}

class EmployeeManager {
    void processEmployees(Employee[] employees) {
        int total = 0; // Local variable

        for (int i = 0; i < employees.length; i++) {
            if (employees[i] instanceof Pharmacist) {
                ((Pharmacist) employees[i]).displayRole();
            } else if (employees[i] instanceof StoreManager) {
                ((StoreManager) employees[i]).displayRole();
            }

            total++;
            System.out.println();
        }

        System.out.println("Processed Employees: " + total);
        System.out.println("Total Employees Created: " +
                           Employee.employeeCount);
    }
}

public class PharmacyEmployeeMain {
    public static void main(String[] args) {
        Employee[] employees = {
            new Pharmacist(101, "Aman", 30000, "LIC101"),
            new StoreManager(102, "Riya", 40000, 2)
        };

        EmployeeManager manager = new EmployeeManager();
        manager.processEmployees(employees);
    }
}
